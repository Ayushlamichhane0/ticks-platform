# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configure this in Netlify site environment variables for the twelve-data function.
# Do not expose this key through a VITE_ variable or frontend code.
TWELVE_DATA_API_KEY="YOUR_TWELVE_DATA_API_KEY"

# Neon Postgres connection strings (keep server-side; never prefix with VITE_).
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"
DATABASE_URL_UNPOOLED="YOUR_NEON_DIRECT_CONNECTION_STRING"

# Public Neon Auth URL used by the browser client (safe to expose).
VITE_NEON_AUTH_URL="https://ep-lingering-bread-a1r5wnr5.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth"

# Configure these server-side for Netlify Functions; never prefix with VITE_.
NEON_AUTH_BASE_URL="https://ep-lingering-bread-a1r5wnr5.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-lingering-bread-a1r5wnr5.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"
